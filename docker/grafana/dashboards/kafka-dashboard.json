{
  "title": "Kafka Consumer Lag & Throughput",
  "tags": [
    "kafka",
    "spring-boot",
    "event-driven"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "panels": [
    {
      "title": "Consumer Lag (Max)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max(kafka_consumer_fetch_manager_records_lag_max) by (client_id, topic)",
          "legendFormat": "{{topic}} ({{client_id}})",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "title": "Consumer Records Consumed Rate",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(kafka_consumer_fetch_manager_records_consumed_rate) by (client_id, topic)",
          "legendFormat": "{{topic}} ({{client_id}})",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "title": "Producer Record Send Rate",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(kafka_producer_record_send_rate) by (client_id, topic)",
          "legendFormat": "{{topic}} ({{client_id}})",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "title": "Total Producer Errors",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(kafka_producer_record_error_rate) by (client_id, topic)",
          "legendFormat": "{{topic}} Errors ({{client_id}})",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "schemaVersion": 38,
  "version": 1
}
