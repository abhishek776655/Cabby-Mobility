{
  "title": "Business Metrics: Smart Mobility",
  "tags": [
    "business",
    "rides"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "panels": [
    {
      "title": "Active Drivers",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "business_drivers_active",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "title": "Live 'In-Progress' Rides",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "business_rides_active",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "title": "Rides Offered",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(business_rides_requested_total)",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value"
      }
    },
    {
      "title": "Rides Completed",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(business_rides_completed_total)",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value"
      }
    },
    {
      "title": "Total Revenue (Fare)",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(business_rides_fare_sum)",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value"
      }
    },
    {
      "title": "Rides Failed (By Reason)",
      "type": "stat",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum by(reason) (business_rides_failed_total)",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value"
      }
    },
    {
      "title": "Available Drivers for Matchmaking",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "business_drivers_active - business_drivers_reserved",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "title": "Active Riders",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "business_riders_active",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "title": "Active Riders In Ride",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "business_riders_active_in_ride",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "title": "Matchmaking Latency (Average)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(business_rides_matchmaking_latency_seconds_sum[1m])) / sum(rate(business_rides_matchmaking_latency_seconds_count[1m]))",
          "legendFormat": "Avg Latency (s)",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "title": "Ride Throughput (Requested vs Completed)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(business_rides_requested_total[1m])) * 60",
          "legendFormat": "Requested (per min)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(business_rides_completed_total[1m])) * 60",
          "legendFormat": "Completed (per min)",
          "refId": "B"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "title": "Cancellation Breakdown Over Time",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(reason) (rate(business_rides_failed_total[1m])) * 60",
          "legendFormat": "{{reason}} (per min)",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ],
  "schemaVersion": 38,
  "version": 2
}