# Loaded automatically by the Expo CLI before app.config.ts is evaluated, so `npm run start`
# is all you need — no inline API_BASE_URL=... WS_URL=... prefixes.
#
# The backend host is auto-detected as this machine's LAN IP (see detectLanHost in
# app.config.ts), so nothing here needs editing when your IP changes. Only the ports and the
# optional overrides below are worth setting.

# Ports the local backend listens on (docker/docker-compose.yml). The gateway fronts both the
# REST API and the /ws STOMP upgrade, so these are the same port by default.
API_PORT=8080
WS_PORT=8080

# Google Maps keys for react-native-maps. Android REQUIRES a key to render map tiles at all
# (without one you get a blank grey map); iOS falls back to Apple Maps when this is empty.
GOOGLE_MAPS_IOS_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=

# --- Optional overrides (uncomment only if you need them) ---
# Pin the host instead of auto-detecting, e.g. when several interfaces confuse detection:
# LAN_HOST=192.168.1.4
#
# Android emulator reaches the host machine via 10.0.2.2, not the LAN IP:
# LAN_HOST=10.0.2.2
#
# Bypass host/port assembly entirely and point at a deployed environment:
# API_BASE_URL=https://api.staging.example.com
# WS_URL=wss://api.staging.example.com/ws
